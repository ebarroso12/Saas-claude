# ─────────────────────────────────────────────────────────────
# KIRO via Evolution API — exemplo de ambiente
# NUNCA commitar o .env real. Segredos vivem no secret manager
# do EasyPanel ou em /root/.kiro/.env com chmod 600.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3040
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo

# ── Evolution API (ponte WhatsApp) ───────────────────────────
EVOLUTION_BASE_URL=https://evolution.example.com
EVOLUTION_INSTANCE=[nome da instancia no Manager]
EVOLUTION_INSTANCE_ID=[uuid do Manager — opcional]
EVOLUTION_API_KEY=[secret manager]
# Segredo que a Evolution envia de volta no header do webhook.
# Configurado em Manager > Instance > Webhook > Headers.
EVOLUTION_WEBHOOK_SECRET=[secret manager]
# Numero/JID da propria instancia — usado para ignorar o proprio eco.
KIRO_WHATSAPP_JID=[numero da instancia]@s.whatsapp.net

# ── Anthropic (o cerebro do Kiro) ────────────────────────────
ANTHROPIC_API_KEY=[secret manager]
# Slot padrao. Ver src/adapters/anthropic.ts para o registry completo.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# ── Identidade (nome de pessoa e configuracao, nao codigo) ───
AGENT_NAME=Kiro
OWNER_TITLE=[como o agente trata o titular, ex: Dr. Fulano]
OWNER_FULL_NAME=[nome completo do titular]
SPOUSE_NAME=[primeiro nome do conjuge — opcional]

# ── Banco ────────────────────────────────────────────────────
DATABASE_URL=[secret manager]

# ── Autorizacao de remetentes ────────────────────────────────
# E.164 sem '+'. O banco guarda SOMENTE o hash; o log mostra
# SOMENTE o prefixo do hash. Numero em claro vive so aqui.
PHONE_HASH_PEPPER=[secret manager — string aleatoria longa]
SENDER_OWNER=[E.164 sem + — numero principal]
SENDER_OWNER_ALT=[E.164 sem + — segundo numero]
SENDER_SPOUSE=[E.164 sem +]
# Numero da clinica: escopo restrito. Fica no OpenClaw na v1.
SENDER_CLINIC=[E.164 sem +]

# ── Conectores (desligados na v1; ligar um por vez) ──────────
# Cada conector so e carregado se ENABLED=true E tiver credencial.
CONNECTOR_DASHBOARD_ENABLED=false
CONNECTOR_DASHBOARD_BASE_URL=https://dashboard.example.com
CONNECTOR_DASHBOARD_TOKEN=[secret manager]

CONNECTOR_INJETAVEIS_ENABLED=false
CONNECTOR_INJETAVEIS_BASE_URL=https://clinica.example.com
CONNECTOR_INJETAVEIS_TOKEN=[secret manager]

CONNECTOR_GOOGLE_ENABLED=false
CONNECTOR_MICROSOFT_ENABLED=false
CONNECTOR_OPENCLAW_ENABLED=false
CONNECTOR_OPENCLAW_BASE_URL=http://127.0.0.1:18789

# ── Transcricao de audio (Claude nao recebe audio) ───────────
TRANSCRIBE_ENABLED=false
TRANSCRIBE_PROVIDER=
TRANSCRIBE_API_KEY=[secret manager]

# ── Politica de confirmacao ──────────────────────────────────
CONFIRMATION_TTL_SECONDS=900
